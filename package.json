{
  "name": "synonyma",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "data:extract": "mkdir -p .cache && curl -sfL https://kaikki.org/frwiktionary/Fran%C3%A7ais/kaikki.org-dictionary-Fran%C3%A7ais.jsonl | python3 scripts/extract-wiktionary.py > .cache/fr-compact.jsonl && curl -sfL https://raw.githubusercontent.com/LibreOffice/dictionaries/master/fr_FR/dictionaries/thes_fr.dat -o .cache/thes_fr.dat",
    "data:build": "node scripts/build-data.mjs .cache/fr-compact.jsonl .cache/thes_fr.dat"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
